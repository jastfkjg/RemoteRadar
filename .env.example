# RemoteRadar 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== API 配置 ==========
# API Key 用于爬虫认证（爬虫调用后端 API 时需要）
API_KEY=your-secret-api-key-here

# 后端 API 地址（爬虫调用时使用）
# 本地开发: http://localhost:8000
# 云服务器: https://your-domain.com
API_URL=http://localhost:8000

# 运行模式: local 或 api
# - local: 直接写入本地 SQLite（本地开发用）
# - api: 调用远程 API（GitHub Actions 生产用）
MODE=local

# ========== 数据库配置 ==========
# SQLite 数据库路径（仅 local 模式使用）
DB_PATH=jobs.db

# ========== CORS 配置 ==========
# 允许的跨域来源（多个用逗号分隔）
# 例如: http://localhost:3000,http://localhost:5173,https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ========== 推荐系统配置 ==========
# 推荐时考虑的用户行为天数
RECOMMEND_HISTORY_DAYS=30

# 每个用户推荐的职位数量
RECOMMEND_LIMIT=20
